# ======================================================================
# COG-EW .gitignore — Clean Repository Configuration
# ======================================================================

# Python Bytecode & Runtime Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Large Datasets & Storage (HDF5, DuckDB, NumPy Arrays)
# These files exceed GitHub file size limits and are generated via scripts
*.h5
*.hdf5
*.duckdb
*.npy
*.npz
data/raw/*
data/intermediate/*
data/augmented/*
data/processed/*.h5
data/splits/*.h5
!data/**/.gitkeep
!data/**/index_report.json
!data/**/baseline_split_report.json
!data/**/split_report.json
!data/**/simulation_metadata.json

# Massive Local Machine Inspection Dumps (> 350 MB)
dataset_inventory.json
reports/dataset_inspection.json
reports/dataset_inspection.md
reports/rf_dataset_inventory.json

# PyTorch checkpoints and large models
checkpoints/
models/checkpoints/*.pt
*.pth
*.onnx

# Temporary & Dump Files
outputs/complete_files_dump.txt
*.log

# Environment & Local Secrets
.env
.env.local

# IDE & OS Specific
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
