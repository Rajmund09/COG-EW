# ============================================================
# COG-EW ENVIRONMENT CONFIGURATION
# ============================================================

# Dataset root.
# If not specified, the application uses ./data
DATA_ROOT=data

# Reproducibility
RANDOM_SEED=42

# Logging
LOG_LEVEL=INFO

# Hardware
# Options:
# auto
# cpu
# cuda
DEVICE=auto

# DataLoader
NUM_WORKERS=2

# Training
BATCH_SIZE=32

# Maximum number of samples used during development.
# Set to 0 for no development limit.
DEV_SAMPLE_LIMIT=10000

# Mixed precision
USE_AMP=true